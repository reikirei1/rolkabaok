-- File Penyimpanan Otomatis (Autosave / Last State)
local AutoStateFile = "LuauScripting_LastState.json"

local function saveLastState()
   if writefile then
      local serializedESP = {}
      for k, v in pairs(ESPSettings) do
         if typeof(v) == "Color3" then
            serializedESP[k] = {r = v.R, g = v.G, b = v.B}
         else
            serializedESP[k] = v
         end
      end

      local data = {Aimbot = AimbotSettings, ESP = serializedESP}
      local success, encoded = pcall(function()
         return HttpService:JSONEncode(data)
      end)
      if success then
         writefile(AutoStateFile, encoded)
      end
   end
end

local function loadLastState()
   if readfile and isfile and isfile(AutoStateFile) then
      local success, decoded = pcall(function()
         return HttpService:JSONDecode(readfile(AutoStateFile))
      end)
      if success and type(decoded) == "table" then
         if decoded.Aimbot then
            for k, v in pairs(decoded.Aimbot) do AimbotSettings[k] = v end
         end
         if decoded.ESP then
            for k, v in pairs(decoded.ESP) do
               if type(v) == "table" and v.r and v.g and v.b then
                  ESPSettings[k] = Color3.new(v.r, v.g, v.b)
               else
                  ESPSettings[k] = v
               end
            end
         end
      end
   end
end

loadLastState()

