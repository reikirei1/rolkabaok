-- ================= LOGIKA ESP & AIMBOT =================

local function createESP(player)
   if espCache[player] then return end
   
   local box = Drawing.new("Square")
   box.Visible = false
   box.Thickness = 1
   box.Filled = false

   local name = Drawing.new("Text")
   name.Visible = false
   name.Size = 14
   name.Center = true
   name.Outline = true
   name.Color = Color3.fromRGB(255, 255, 255)

   local healthBg = Drawing.new("Square")
   healthBg.Visible = false
   healthBg.Filled = true
   healthBg.Color = Color3.fromRGB(0, 0, 0)

   local healthBar = Drawing.new("Square")
   healthBar.Visible = false
   healthBar.Filled = true

   local tracer = Drawing.new("Line")
   tracer.Visible = false
   tracer.Thickness = 1

   local highlight = Instance.new("Highlight")
   highlight.FillTransparency = 0.5
   highlight.OutlineTransparency = 0

   espCache[player] = {
      Box = box,
      Name = name,
      HealthBg = healthBg,
      HealthBar = healthBar,
      Tracer = tracer,
      Highlight = highlight
   }
end

local function removeESP(player)
   if espCache[player] then
      if espCache[player].Box then espCache[player].Box:Remove() end
      if espCache[player].Name then espCache[player].Name:Remove() end
      if espCache[player].HealthBg then espCache[player].HealthBg:Remove() end
      if espCache[player].HealthBar then espCache[player].HealthBar:Remove() end
      if espCache[player].Tracer then espCache[player].Tracer:Remove() end
      if espCache[player].Highlight then espCache[player].Highlight:Destroy() end
      espCache[player] = nil
   end
end

Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)
for _, p in pairs(Players:GetPlayers()) do
   if p ~= LocalPlayer then createESP(p) end
end

-- Lingkaran FOV untuk Aimbot
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Filled = false

local function isVisible(targetPart)
   if not AimbotSettings.WallCheck then return true end
   local origin = Camera.CFrame.Position
   local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
   local raycastParams = RaycastParams.new()
   raycastParams.FilterType = Enum.RaycastFilterType.Exclude
   raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
   local result = Workspace:Raycast(origin, direction, raycastParams)
   if result then
      local hitCharacter = result.Instance:FindFirstAncestorOfClass("Model")
      if hitCharacter and hitCharacter == targetPart.Parent then return true end
      return false
   end
   return true
end

local function getClosestPlayerInFOV()
   local closestPlayer = nil
   local shortestDistance = AimbotSettings.FOV
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer then
         local passTeam = true
         if AimbotSettings.TeamCheck and player.Team == LocalPlayer.Team then passTeam = false end
         if passTeam and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local targetPart = player.Character:FindFirstChild(AimbotSettings.TargetPart)
            if targetPart then
               local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
               if onScreen then
                  local mouseLocation = UserInputService:GetMouseLocation()
                  local distanceToMouse = (Vector2.new(screenPoint.X, screenPoint.Y) - mouseLocation).Magnitude
                  if distanceToMouse < shortestDistance and isVisible(targetPart) then
                     closestPlayer = player
                     shortestDistance = distanceToMouse
                  end
               end
            end
         end
      end
   end
   return closestPlayer
end

local function isAnyTargetInFOV()
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer then
         local passTeam = true
         if AimbotSettings.TeamCheck and player.Team == LocalPlayer.Team then passTeam = false end
         if passTeam and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local targetPart = player.Character:FindFirstChild(AimbotSettings.TargetPart)
            if targetPart then
               local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
               if onScreen then
                  local mouseLocation = UserInputService:GetMouseLocation()
                  local distanceToMouse = (Vector2.new(screenPoint.X, screenPoint.Y) - mouseLocation).Magnitude
                  if distanceToMouse < AimbotSettings.FOV and isVisible(targetPart) then
                     return true
                  end
               end
            end
         end
      end
   end
   return false
end

-- Loop Utama Render (Aimbot, FOV, FOV Changer & ESP)
RunService.RenderStepped:Connect(function()
   local mouseLoc = UserInputService:GetMouseLocation()
   
   -- Pengaturan Visual FOV Circle & Dynamic Color
   FOVCircle.Position = mouseLoc
   FOVCircle.Radius = AimbotSettings.FOV
   FOVCircle.Transparency = AimbotSettings.FOVTransparency
   FOVCircle.Thickness = AimbotSettings.FOVThickness
   FOVCircle.Filled = AimbotSettings.FOVFilled
   FOVCircle.Visible = AimbotSettings.Enabled

   if isAnyTargetInFOV() then
      FOVCircle.Color = Color3.fromRGB(0, 255, 0)
   else
      FOVCircle.Color = Color3.fromRGB(255, 255, 255)
   end

   -- FOV Changer Kamera
   if AimbotSettings.FOVChangerEnabled then
      Camera.FieldOfView = AimbotSettings.CameraFOV
   end

   -- --- Eksekusi Aimbot ---
   local isHolding = false
   local keyName = AimbotSettings.SelectedKeyName
   if keyName == "MouseButton2" then
      isHolding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
   elseif keyName == "LeftShift" then
      isHolding = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
   elseif keyName == "LeftAlt" then
      isHolding = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
   elseif keyName == "E" then
      isHolding = UserInputService:IsKeyDown(Enum.KeyCode.E)
   elseif keyName == "Q" then
      isHolding = UserInputService:IsKeyDown(Enum.KeyCode.Q)
   elseif keyName == "C" then
      isHolding = UserInputService:IsKeyDown(Enum.KeyCode.C)
   end

   if AimbotSettings.Enabled and isHolding then
      local target = getClosestPlayerInFOV()
      if target and target.Character and target.Character:FindFirstChild(AimbotSettings.TargetPart) then
         local targetPart = target.Character[AimbotSettings.TargetPart]
         local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
         if AimbotSettings.StickyAim then
            Camera.CFrame = targetCFrame
         else
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / math.max(AimbotSettings.Smoothness, 1))
         end
      end
   end

   -- --- Eksekusi ESP ---
   for player, data in pairs(espCache) do
      local character = player.Character
      local humanoid = character and character:FindFirstChild("Humanoid")
      local rootPart = character and character:FindFirstChild("HumanoidRootPart")

      local shouldRender = true
      if ESPSettings.Enabled and ESPSettings.EnemyOnly and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
         shouldRender = false
      end

      if ESPSettings.Enabled and shouldRender and character and humanoid and rootPart and humanoid.Health > 0 then
         -- Penentuan Posisi 3D Atas (Kepala) dan Bawah (Kaki) Presisi Terhadap Kamera Saat Ini (Termasuk Zoom/Scope)
         local head = character:FindFirstChild("Head")
         local headWorldPos = head and (head.Position + Vector3.new(0, 0.5, 0)) or (rootPart.Position + Vector3.new(0, 3, 0))
         local legWorldPos = rootPart.Position - Vector3.new(0, 3, 0)

         local headScreen, headOnScreen = Camera:WorldToViewportPoint(headWorldPos)
         local legScreen, legOnScreen = Camera:WorldToViewportPoint(legWorldPos)

         if headOnScreen or legOnScreen then
            local height = math.abs(headScreen.Y - legScreen.Y)
            local width = height / 2.1
            local boxPos = Vector2.new(headScreen.X - width / 2, headScreen.Y)

            local boxCol = ESPSettings.BoxRGB and getRainbowColor(0.3) or (ESPSettings.TeamColor and player.Team and player.TeamColor.Color or ESPSettings.BoxColor)
            local chamsCol = ESPSettings.ChamsRGB and getRainbowColor(0.3) or (ESPSettings.TeamColor and player.Team and player.TeamColor.Color or ESPSettings.ChamsColor)
            local outlineCol = ESPSettings.OutlineRGB and getRainbowColor(0.3) or (ESPSettings.TeamColor and player.Team and player.TeamColor.Color or ESPSettings.OutlineColor)
            local tracerCol = ESPSettings.TracerRGB and getRainbowColor(0.3) or (ESPSettings.TeamColor and player.Team and player.TeamColor.Color or ESPSettings.TracerColor)

            -- 1. ESP Box
            if ESPSettings.Box then
               data.Box.Size = Vector2.new(width, height)
               data.Box.Position = boxPos
               data.Box.Color = boxCol
               data.Box.Visible = true
            else
               data.Box.Visible = false
            end

            -- 2. ESP Name (Ditempatkan Di Atas Box Secara Dinamis)
            if ESPSettings.Name then
               data.Name.Text = player.Name
               data.Name.Position = Vector2.new(headScreen.X, headScreen.Y - 16)
               data.Name.Visible = true
            else
               data.Name.Visible = false
            end

            -- 3. ESP Health (Ditempatkan Di Samping Kiri Box Secara Dinamis)
            if ESPSettings.Health then
               local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
               local barHeight = height * healthPercent
               
               data.HealthBg.Size = Vector2.new(4, height)
               data.HealthBg.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
               data.HealthBg.Visible = true

               data.HealthBar.Size = Vector2.new(2, math.max(barHeight - 2, 1))
               data.HealthBar.Position = Vector2.new(boxPos.X - 5, boxPos.Y + (height - barHeight) + 1)
               data.HealthBar.Color = Color3.fromRGB(255 - (healthPercent * 255), healthPercent * 255, 0)
               data.HealthBar.Visible = true
            else
               data.HealthBg.Visible = false
               data.HealthBar.Visible = false
            end

            -- 4. Tracer
            if ESPSettings.Tracer then
               local originPos
               if ESPSettings.TracerOrigin == "Bawah Layar" then
                  originPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
               elseif ESPSettings.TracerOrigin == "Tengah Layar" then
                  originPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
               elseif ESPSettings.TracerOrigin == "Atas Layar" then
                  originPos = Vector2.new(Camera.ViewportSize.X / 2, 0)
               else
                  originPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
               end

               data.Tracer.From = originPos
               data.Tracer.To = Vector2.new(legScreen.X, legScreen.Y)
               data.Tracer.Color = tracerCol
               data.Tracer.Visible = true
            else
               data.Tracer.Visible = false
            end

            -- 5. Outline & Chams Avatar
            if ESPSettings.Outline or ESPSettings.Chams then
               data.Highlight.Parent = character
               data.Highlight.Enabled = true
               data.Highlight.FillColor = chamsCol
               data.Highlight.FillTransparency = ESPSettings.Chams and ESPSettings.ChamsTransparency or 1
               data.Highlight.OutlineColor = outlineCol
               data.Highlight.OutlineTransparency = ESPSettings.Outline and 0 or 1
            else
               data.Highlight.Enabled = false
            end
         else
            data.Box.Visible = false
            data.Name.Visible = false
            data.HealthBg.Visible = false
            data.HealthBar.Visible = false
            data.Tracer.Visible = false
            data.Highlight.Enabled = false
         end
      else
         data.Box.Visible = false
         data.Name.Visible = false
         data.HealthBg.Visible = false
         data.HealthBar.Visible = false
         data.Tracer.Visible = false
         data.Highlight.Enabled = false
      end
   end
end)
